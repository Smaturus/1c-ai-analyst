digraph "security-zones" {
  graph [rankdir="LR", bgcolor="white", pad="0.45", nodesep="0.55", ranksep="0.85", fontname="Segoe UI", fontsize="11", labelloc="t", labeljust="l",
         label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
           <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16"><B>Зоны доверия и контроли</B></FONT></TD></TR>
           <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#5A6B7B">Что где находится и чем ограничены переходы между зонами</FONT></TD></TR>
           
         </TABLE>>,
         dpi="200"];
  node [shape="box", style="rounded,filled", fontname="Segoe UI", fontsize="11", penwidth="1.2", margin="0.10,0.06"];
  edge [fontname="Segoe UI", fontsize="9", color="#5A6B7B", fontcolor="#1F2933", arrowsize="0.75", penwidth="1.1"];
  subgraph cluster_shop {
    label=<<FONT POINT-SIZE="10" COLOR="#5A6B7B"><B>Учётная система</B></FONT>>;
    labeljust="l"; style="rounded,dashed"; color="#9AA7B4"; penwidth="1.1";
    fontname="Segoe UI"; margin="14";
  "onec" [shape="box", fillcolor="#7D8B99", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#D6E4F0">external</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF"><B>1С:УТ</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#D6E4F0">источник данных</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_trusted {
    label=<<FONT POINT-SIZE="10" COLOR="#5A6B7B"><B>Доверенная зона: рабочее место</B></FONT>>;
    labeljust="l"; style="rounded,dashed"; color="#9AA7B4"; penwidth="1.1";
    fontname="Segoe UI"; margin="14";
  "mcp" [shape="box", fillcolor="#438DD5", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#D6E4F0">container</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF"><B>MCP Server</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#D6E4F0">read-only, allowlist</FONT></TD></TR></TABLE>>];
  "engine" [shape="box", fillcolor="#438DD5", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#D6E4F0">container</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF"><B>Движок</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#D6E4F0">без сети</FONT></TD></TR></TABLE>>];
  "files" [shape="box", fillcolor="#2E6DA4", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#D6E4F0">store</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF"><B>Витрина + аудит</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#D6E4F0">локальные файлы</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_agent {
    label=<<FONT POINT-SIZE="10" COLOR="#5A6B7B"><B>Платформа агента (внешняя)</B></FONT>>;
    labeljust="l"; style="rounded,dashed"; color="#9AA7B4"; penwidth="1.1";
    fontname="Segoe UI"; margin="14";
  "hermes" [shape="box", fillcolor="#7D8B99", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#D6E4F0">external</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF"><B>Hermes Agent</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#D6E4F0">toolset ограничен</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_external {
    label=<<FONT POINT-SIZE="10" COLOR="#5A6B7B"><B>Внешние сервисы</B></FONT>>;
    labeljust="l"; style="rounded,dashed"; color="#9AA7B4"; penwidth="1.1";
    fontname="Segoe UI"; margin="14";
  "llm" [shape="box", fillcolor="#7D8B99", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#D6E4F0">external</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF"><B>LLM-провайдер</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#D6E4F0">диалог агента</FONT></TD></TR></TABLE>>];
  "msg" [shape="box", fillcolor="#7D8B99", fontcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#D6E4F0">external</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#FFFFFF"><B>Мессенджер</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#D6E4F0">канал доставки</FONT></TD></TR></TABLE>>];
  }
  "onec" -> "files" [style="solid", arrowhead="vee", label="CSV + meta (ETL)"];
  "hermes" -> "mcp" [style="solid", arrowhead="vee", label="MCP/stdio · allowlist"];
  "mcp" -> "files" [style="solid", arrowhead="vee", label="read-only · аудит"];
  "mcp" -> "engine" [style="solid", arrowhead="vee", label="dispatch_intent"];
  "hermes" -> "llm" [style="dashed", arrowhead="vee", label="HTTPS · провайдер по выбору"];
  "hermes" -> "msg" [style="dashed", arrowhead="vee", label="API · allowlist"];
}
