digraph "data-model" {
  graph [rankdir="LR", bgcolor="white", pad="0.45", nodesep="0.55", ranksep="0.85", fontname="Segoe UI", fontsize="11", labelloc="t", labeljust="l",
         label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
           <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16"><B>Модель данных</B></FONT></TD></TR>
           <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#5A6B7B">Витрина, метаданные выгрузки и журнал аудита</FONT></TD></TR>
           
         </TABLE>>,
         dpi="200"];
  node [shape="box", style="rounded,filled", fontname="Segoe UI", fontsize="11", penwidth="1.2", margin="0.10,0.06"];
  edge [fontname="Segoe UI", fontsize="9", color="#5A6B7B", fontcolor="#1F2933", arrowsize="0.75", penwidth="1.1"];
  "vitrina" [shape="box", style="rounded,filled", fillcolor="white", color="#9AA7B4", penwidth="1.2", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" COLSPAN="3" BGCOLOR="#D9C2E9"><FONT POINT-SIZE="10"><B>VITRINA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="3"><FONT POINT-SIZE="8" COLOR="#5A6B7B">витрина продаж (CSV)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">date</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">product</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">counterparty</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">quantity</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">float</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">revenue</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">float</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">product_group</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">string</FONT></TD></TR></TABLE>>];
  "meta" [shape="box", style="rounded,filled", fillcolor="white", color="#9AA7B4", penwidth="1.2", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" COLSPAN="3" BGCOLOR="#D9C2E9"><FONT POINT-SIZE="10"><B>EXPORT_META</B></FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="3"><FONT POINT-SIZE="8" COLOR="#5A6B7B">метаданные выгрузки (JSON)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">exported_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">rows</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">source</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">revenue_mode</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">string</FONT></TD></TR></TABLE>>];
  "audit" [shape="box", style="rounded,filled", fillcolor="white", color="#9AA7B4", penwidth="1.2", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT" COLSPAN="3" BGCOLOR="#D9C2E9"><FONT POINT-SIZE="10"><B>AUDIT_EVENT</B></FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="3"><FONT POINT-SIZE="8" COLOR="#5A6B7B">журнал вызовов (JSONL)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ts</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">event</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">intent</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">params</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">dataset</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">period</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">rows</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">shown</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">exported_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">triggered</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">bool</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">reason</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">details</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#5A6B7B">string</FONT></TD></TR></TABLE>>];
  "vitrina" -> "meta" [style="solid", arrowhead="none", label="1 : 1 · рядом с CSV"];
  "vitrina" -> "audit" [style="dashed", arrowhead="none", label="1 : N · вызовы срезов"];
}
