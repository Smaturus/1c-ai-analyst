# Пример настроек LLM. Скопируйте в .env / переменные окружения и заполните.
# При LLM_PROVIDER=none приложение работает в офлайн-режиме (правила, без LLM).

# Провайдер по умолчанию: none | openai | deepseek | ollama | gigachat
LLM_PROVIDER=none

# Модель по умолчанию для выбранного провайдера
# (deepseek: deepseek-chat, openai: gpt-4o-mini, ollama: qwen3:4b, gigachat: GigaChat-2-Pro)
# ВАЖНО: LLM_MODEL и LLM_BASE_URL принадлежат ТОЛЬКО провайдеру из LLM_PROVIDER —
# сокращение для LLM_MODEL_<PROVIDER>/LLM_BASE_URL_<PROVIDER>. На провайдера,
# выбранного в UI переключателем, они не распространяются: у него свой дефолт.
LLM_MODEL=

# Ключ API по умолчанию (для ollama не нужен — клиент подставляет заглушку;
# для gigachat — authorization key = base64(client_id:client_secret))
LLM_API_KEY=

# Базовый URL OpenAI-совместимого API (без /chat/completions)
# LLM_BASE_URL=https://api.deepseek.com/v1

# --- Несколько провайдеров одновременно (переключатель в UI) -------------------
# Свои ключи/модели для отдельных провайдеров. В сайдбаре появится выбор
# «Провайдер LLM», если настроено >1 провайдера.
# Пустое значение (например, LLM_MODEL_GIGACHAT=) — «у провайдера своя модель»:
# он получит свой дефолт, а не модель провайдера по умолчанию.
# LLM_API_KEY_DEEPSEEK=sk-...
# LLM_MODEL_DEEPSEEK=deepseek-chat
# LLM_BASE_URL_DEEPSEEK=https://api.deepseek.com/v1
# LLM_API_KEY_GIGACHAT=base64(client_id:client_secret)
# LLM_MODEL_GIGACHAT=GigaChat-2-Pro

# --- Локальная Ollama (провайдер ollama; нулевая стоимость токенов) ------------
# Сервер: http://localhost:11434 (только localhost, OLLAMA_HOST не менять).
# Модели лежат на D:\ollama\models (пользовательская переменная OLLAMA_MODELS).
# OLLAMA_MODEL/OLLAMA_BASE_URL — аддитивные клиентские настройки: они уступают
# LLM_MODEL_OLLAMA/LLM_BASE_URL_OLLAMA и действуют только при provider=ollama.
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Контекст и thinking — решения DECISIONS #17 (осознанные, не дефолт Ollama):
# num_ctx 4096 → 8192 (растёт только KV-кэш ~1 ГБ, prompt-eval не меняется);
# think=false — меньше латентности и риска, что reasoning попадёт в JSON-DSL.
# OLLAMA_NUM_CTX=8192
# OLLAMA_THINK=0

# --- GigaChat (Сбер): OAuth + TLS НУЦ Минцифры --------------------------------
# scope: GIGACHAT_API_PERS | GIGACHAT_API_CORP | GIGACHAT_API_B2B
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Эндпоинт OAuth-токена (по умолчанию — официальный)
# GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Корневой сертификат НУЦ Минцифры (обязателен для облака Сбера):
# https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt
# Если путь указан, а файла нет — провайдер помечается «не настроен».
# LLM_TLS_CA_BUNDLE=C:\path\to\russian_trusted_root_ca_pem.crt
# Только для отладки: 0 — отключить проверку TLS (не для боевой)
# LLM_TLS_VERIFY=1

# Таймаут запроса, секунды (общий для всех провайдеров)
LLM_TIMEOUT=60

# Температура (0 — детерминированно; общая для всех провайдеров)
LLM_TEMPERATURE=0

# Ручной сброс лимита LLM в сайдбаре (1/true — показать кнопку; по умолчанию выкл.)
# RATE_LIMIT_ALLOW_RESET=1
