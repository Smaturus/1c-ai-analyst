# Пример настроек LLM. Скопируйте в .env / переменные окружения и заполните.
# При LLM_PROVIDER=none приложение работает в офлайн-режиме (правила, без LLM).

# none | openai | deepseek | ollama
LLM_PROVIDER=none

# Модель провайдера (для deepseek: deepseek-chat, openai: gpt-4o-mini, ollama: llama3.1)
LLM_MODEL=

# Ключ API (для ollama не нужен)
LLM_API_KEY=

# Базовый URL OpenAI-совместимого API (без /chat/completions)
# LLM_BASE_URL=https://api.deepseek.com/v1

# Таймаут запроса, секунды
LLM_TIMEOUT=60

# Температура (0 — детерминированно)
LLM_TEMPERATURE=0
