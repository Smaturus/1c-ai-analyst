#!/bin/sh
# Страж правила «файлы со словом Mistral не публикуются».
#
# .gitignore сравнивает только пути и не действует на уже отслеживаемые файлы,
# поэтому содержание проверяется здесь: если в коммит попадает файл, внутри
# которого есть это слово, коммит не создаётся.
#
# Исключения — инфраструктура самого правила: .gitignore (в нём маски для имён)
# и сами хуки, которые обязаны содержать слово, чтобы искать его.
#
# Установка (один раз на клоне): git config core.hooksPath .githooks
# Обход через --no-verify запрещён правилами проекта.

set -e

EXCLUDE_RE='^\.gitignore$|^\.githooks/pre-commit$|^\.githooks/pre-push$'
HITS=""

for f in $(git diff --cached --name-only --diff-filter=ACM); do
    echo "$f" | grep -Eq "$EXCLUDE_RE" && continue
    [ -f "$f" ] || continue
    if grep -Iilq "mistral" -- "$f"; then
        HITS="${HITS}${f}
"
    fi
done

if [ -n "$HITS" ]; then
    echo "[pre-commit] ОТКАЗ: в коммите есть файлы со словом Mistral:" >&2
    printf '%s' "$HITS" | sed 's/^/  - /' >&2
    echo "[pre-commit] Правило проекта: такие файлы не публикуются." >&2
    echo "[pre-commit] Уберите слово из файла или не добавляйте файл в коммит." >&2
    exit 1
fi
